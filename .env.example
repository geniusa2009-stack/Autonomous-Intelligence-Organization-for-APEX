# APEX ONE ULTRA — example environment. Copy to .env and fill ONLY what you have.
# Never commit .env. Keys are read from the environment; they are never written to artifacts.

# ---- Hard cost policy (cannot be relaxed: the firewall ignores attempts to enable these) ----
APEX_MAX_API_COST_USD=0.00
APEX_PAID_FALLBACK_ALLOWED=false
APEX_AUTO_BILLING_ALLOWED=false
APEX_AUTO_UPGRADE_ALLOWED=false
APEX_QUOTA_BYPASS_ALLOWED=false

# ---- Storage ----
APEX_DATABASE_URL=sqlite:///var/apex_one.db
# APEX_DATABASE_URL=postgresql+psycopg://apex:apex@localhost:5432/apex_one
APEX_ARTIFACTS_DIR=artifacts

# ---- Free-tier remote providers (optional; leave blank if not used) ----
NVIDIA_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
HF_TOKEN=

# ---- Local / self-hosted inference (optional) ----
OLLAMA_BASE_URL=http://localhost:11434
LLAMACPP_BASE_URL=http://localhost:8080
VLLM_BASE_URL=
SGLANG_BASE_URL=
# Self-hosted specialist design models served behind an OpenAI-compatible endpoint
APEX_DESIGN_ENDPOINT_POSTERCOPILOT=
APEX_DESIGN_ENDPOINT_WEBGENAGENT=
APEX_DESIGN_ENDPOINT_OMNIDOCLAYOUT=

# ---- Research ----
SEARXNG_URL=
APEX_RESEARCH_USER_AGENT=APEX-ONE-Research/0.1 (+contact: set-me)

# ---- Rendering ----
# APEX_CHROMIUM_PATH=/opt/pw-browsers/chromium-1194/chrome-linux/chrome

# ---- Tests ----
APEX_LIVE_TESTS=0
